<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SFI.View.Teacher.ShowStudentInfoPage"
             Title="ShowStudentInfoPage"
             xmlns:components="clr-namespace:SFI.View.Components">
    <VerticalStackLayout BackgroundColor="Black">

      

        <Grid ColumnDefinitions="*, Auto">
            <components:GoBackButton  
                Grid.Column="0"
                Margin="0,0,0,20"/>
            

            <Button Text="Ta bort eleven"
                WidthRequest="120"
                HeightRequest="40"
                BackgroundColor="DarkRed"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,20,10,0"
                TextColor="White"
                Clicked="OnDeleteClicked"/>
        </Grid>
        

        <Label x:Name="NamnLabel" Text="Namn:" FontAttributes="Bold" />

        <Label  x:Name="EmailLabel" Text="Email:" FontAttributes="Bold" Margin="0,20,0,0" />

        <Label  x:Name="PhoneLabel" Text="Telefonnummer:" FontAttributes="Bold" Margin="0,20,0,0" />
        
        <Label x:Name="KlassIdLabel" Text="KlassId:" FontAttributes="Bold" Margin="0,20,0,0" />

        <Grid
            ColumnDefinitions="*,Auto">
            <Label  x:Name="LösenordLabel"  Text="Lösenord:" FontAttributes="Bold" Margin="0,20,0,0" Grid.Column="0" />
            <Button 
                x:Name="ChangePassword" 
                Text="ändra lösenord"  
                Grid.Column="1" 
                Margin="0,10,0,0"
                BackgroundColor="DarkGrey"
                WidthRequest="130"
                Clicked="OnChangePasswordClicked"/>

        </Grid>

        <VerticalStackLayout 
            x:Name="PasswordChangePanel"
            Spacing="10"
            Margin="0,10,0,0"
            IsVisible="False">
            <Entry x:Name="NewPasswordEntry"
                Placeholder="Nytt lösenord"
            />

            <Entry x:Name="RepeatPasswordEntry"
                Placeholder="Upprepa lösenord"
            />

            <Button
                Text="Spara"
                BackgroundColor="GreenYellow"
                Clicked="OnSavePasswordClicked"/>

        </VerticalStackLayout>


        <Button
            Text="Nivåer"
            WidthRequest="90"
            HeightRequest="40"
            BackgroundColor="BlueViolet"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="0,20,10,0"
            TextColor="White"
            Clicked="OnLevelClicked" />


        <Button
            Text="Närvarande"
            WidthRequest="160"
            HeightRequest="40"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="0,20,10,0"
            TextColor="White"
            BackgroundColor="DarkGreen"
            Clicked="OnAttendanceClicked"/>


    </VerticalStackLayout>
</ContentPage>