<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SFI.View.WeatherPage"
             Title="WeatherPage"
             BackgroundImageSource="{Binding BackgroundImage}">
    <VerticalStackLayout BackgroundColor="Transparent" Padding="20">

        <Entry Placeholder="Ange stad" BackgroundColor="Beige" TextColor="Black" Text="{Binding City}" />

        <Button Text="Hämta Väder" BackgroundColor="SeaGreen" Command="{Binding LoadWeatherCommand}" />

        <Label Text="{Binding WeatherText}"
               FontSize="25"
               TextColor="Wheat"
               Margin="0,30,0,0"/>

    </VerticalStackLayout>
</ContentPage>