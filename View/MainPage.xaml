<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SFI.MainPage">

    <ScrollView>
            <VerticalStackLayout BackgroundColor="LightSlateGray" Padding="30" Spacing="25">

                <Label
                Text="VälKommen till SFI" 
                TextColor="BurlyWood"
                FontSize="20"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                />


                <Entry
                x:Name="email"
                Placeholder="användare namn"
                BackgroundColor="BlanchedAlmond"
                TextColor="Black"
                />

                <Entry
                x:Name="Password"
                IsPassword="True"
                Placeholder="lösenord"
                BackgroundColor="BlanchedAlmond"
                TextColor="Black"
                />



                <Button
                Text="loga in"
                CornerRadius="25"
                BackgroundColor="LightGreen"
                Margin="70,20"
                Clicked="OnLogInClicked"
                />
                
                

            </VerticalStackLayout>
    </ScrollView>
</ContentPage>
